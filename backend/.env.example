# Database
DATABASE_URL=postgresql+psycopg2://ironman_app:CHANGE_ME@localhost:5432/ironman_coach

# Optional: pre-fills the email prompt in scripts/garmin_login.py. Your
# Garmin password is never stored here or anywhere else -- see that script.
GARMIN_EMAIL=

# Optional: fixed training location for weather (decimal degrees). If unset,
# it's derived automatically from your most recent GPS-tagged activity.
LOCATION_LAT=
LOCATION_LON=

# Google Calendar OAuth -- see README for how to create these in Google
# Cloud Console. GOOGLE_CLIENT_SECRET is a real credential; backend/.env is
# gitignored, never commit it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# AI coach (Phase 6). Free tier, no credit card -- get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Canvas (Phase 7 -- unified to-do list). Personal access token, from
# Canvas: Account -> Settings -> New Access Token.
CANVAS_DOMAIN=your-school.instructure.com
CANVAS_ACCESS_TOKEN=

# Used to sign session/state values. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Frontend origin, for CORS (Phase 2+)
FRONTEND_ORIGIN=http://localhost:3000
